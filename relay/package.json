{
  "name": "@okaiwa/relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Okaiwa relay server — encrypted message transit only, zero storage",
  "imports": {
    "#app/*": "./app/*.js",
    "#config/*": "./config/*.js",
    "#start/*": "./start/*.js"
  },
  "scripts": {
    "start": "node build/bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "vitest",
    "test:unit": "vitest run",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@adonisjs/core": "^6.21.0",
    "@adonisjs/redis": "^9.2.0",
    "@vinejs/vine": "^2.1.0",
    "pino": "^9.14.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.8.2",
    "@swc/core": "^1.15.33",
    "@types/node": "^22.19.19",
    "eslint": "^9.39.4",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "ts-node-maintained": "^10.9.6",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
