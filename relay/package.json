{
  "name": "@okaiwa/relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#app/*": "./app/*.js",
    "#config/*": "./config/*.js",
    "#start/*": "./start/*.js"
  },
  "description": "Okaiwa relay server — encrypted message transit only, zero storage",
  "scripts": {
    "start": "node build/bin/server.js",
    "build": "tsc",
    "dev": "node --loader ts-node/esm bin/server.ts",
    "test": "vitest",
    "test:unit": "vitest run",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@adonisjs/core": "^6.14.1",
    "@adonisjs/redis": "^9.1.0",
    "@vinejs/vine": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.16.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
