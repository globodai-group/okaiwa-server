{
  "name": "@okaiwa/identity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Okaiwa identity server — user registration, key management, and privacy-preserving discovery",
  "imports": {
    "#app/*": "./app/*.js",
    "#config/*": "./config/*.js",
    "#start/*": "./start/*.js",
    "#database/*": "./database/*.js"
  },
  "scripts": {
    "start": "node build/bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "vitest",
    "test:unit": "vitest run",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "migration:run": "node ace migration:run"
  },
  "dependencies": {
    "@adonisjs/core": "^6.14.1",
    "@adonisjs/lucid": "^21.3.0",
    "@adonisjs/redis": "^9.1.0",
    "@vinejs/vine": "^2.1.0",
    "luxon": "^3.5.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.8.2",
    "@swc/core": "^1.10.1",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "eslint": "^9.16.0",
    "prettier": "^3.4.2",
    "ts-node-maintained": "^10.9.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.0",
    "pino-pretty": "^13.0.0"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
