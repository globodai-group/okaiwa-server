{
  "name": "@okaiwa/blockchain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Okaiwa blockchain RPC proxy — anonymous relay to Alchemy/Infura/public RPCs",
  "imports": {
    "#app/*": "./app/*.js",
    "#config/*": "./config/*.js",
    "#start/*": "./start/*.js"
  },
  "scripts": {
    "start": "node build/bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "vitest",
    "test:unit": "vitest run",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@adonisjs/core": "^6.14.1",
    "@vinejs/vine": "^2.1.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.8.2",
    "@swc/core": "^1.10.1",
    "@types/node": "^22.10.0",
    "eslint": "^9.16.0",
    "prettier": "^3.4.2",
    "ts-node-maintained": "^10.9.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.0"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
