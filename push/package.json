{
  "name": "@okaiwa/push",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Okaiwa push notification gateway — silent notifications with ZERO message content",
  "imports": {
    "#app/*": "./app/*.js",
    "#config/*": "./config/*.js",
    "#start/*": "./start/*.js"
  },
  "scripts": {
    "start": "node build/bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "vitest",
    "test:unit": "vitest run",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@adonisjs/core": "^6.14.1",
    "@vinejs/vine": "^2.1.0",
    "reflect-metadata": "^0.2.2",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@swc/core": "^1.10.1",
    "@types/node": "^22.10.0",
    "eslint": "^9.16.0",
    "prettier": "^3.4.2",
    "ts-node-maintained": "^10.9.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.0",
    "pino-pretty": "^13.0.0"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
